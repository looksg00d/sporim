{
  "name": "@sporim/chain",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The Solana escrow layer behind ChainAdapter: types + interface now, mock and devnet adapters next. No React, no Node, no DOM — Expo reuses this verbatim.",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "generate": "node scripts/generate.mjs"
  },
  "dependencies": {
    "@solana/kit": "^8.3.0",
    "@solana/web3.js": "^1.98.4",
    "@sporim/domain": "workspace:*"
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "^1.5.6",
    "@codama/renderers-js": "^2.5.0",
    "@sporim/config": "workspace:*",
    "@sporim/testing": "workspace:*",
    "codama": "^1.11.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.7"
  }
}
