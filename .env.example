# Copy to .env.local and fill in. Names only here — never commit values.

# --- app ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=local            # local | preview | production
NEXT_PUBLIC_CHAIN_MODE=mock          # mock | devnet

# --- privy ---
# APP_ID is public by design — it ships in the browser bundle. Everything else is server-only.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
# ES256 public keys used to verify the access token server-side. Derived from the app id, but
# kept as a variable so a rotation or a self-hosted proxy does not need a code change.
PRIVY_JWKS_URL=
PRIVY_WEBHOOK_SIGNING_KEY=

# --- database (Xata: plain Postgres) ---
# Server-only. There is no browser-facing database key by design: every read and write goes
# through the server layer, so no anon credential exists to leak.
DATABASE_URL=

# --- solana ---
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_RPC_URL=https://api.devnet.solana.com
HELIUS_API_KEY=
NEXT_PUBLIC_PROGRAM_ID=
NEXT_PUBLIC_USDC_MINT=
NEXT_PUBLIC_TREASURY_ADDRESS=
NEXT_PUBLIC_FEE_BPS=300
NEXT_PUBLIC_DISPUTE_BOND_BPS=1000
NEXT_PUBLIC_MAX_STAKE_USDC=100
FAUCET_KEYPAIR=
ADMIN_KEYPAIR_PATH=

# --- analytics & ops ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
IP_HASH_PEPPER=
OG_IMAGE_SECRET=

# --- phase 1 ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
