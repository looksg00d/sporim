{
  "name": "@sporim/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "SPORIM web app — Next.js App Router, the only surface in Phase 0.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "migrate": "node --experimental-strip-types --no-warnings src/server/db/migrate.ts",
    "lint": "eslint src",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@privy-io/react-auth": "^3.40.0",
    "@solana-program/memo": "^0.8.0",
    "@solana-program/system": "^0.8.0",
    "@solana-program/token": "^0.6.0",
    "@solana/kit": "^3.0.3",
    "@sporim/domain": "workspace:*",
    "@sporim/ui": "workspace:*",
    "jose": "^6.2.10",
    "next": "^15.5.0",
    "postgres": "^3.4.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@sporim/config": "workspace:*",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.7"
  }
}
